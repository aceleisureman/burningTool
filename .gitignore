# Dependencies
node_modules/

# Build output
dist/

# Downloaded/bundled toolchains (large binaries, not source)
/toolchain/
/resources/

# Runtime-generated command tools (busybox applets)
/tools/

# Logs & temp
*.log
float-debug.txt
*.tmp

# OS / editor
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# 本地临时输出
_test_out.txt
install_out.txt
.claude/
.superpowers/

# 图标全幅原稿备份（仅本地）
assets/icons/_fullbleed_backup/

# Vite-generated temporary config snapshots
vite.config.mjs.timestamp-*.mjs

# VS Code 扩展打包产物与 vendor 拷贝（源在 packages/flash-core）
*.vsix
plugins/**/vendor/

# 字体子集化：完整原字体备份与临时字符集（源字体重在仓库外，本地保留用于重新子集化）
renderer/fonts/*.full.woff2
renderer/fonts/_subset_chars.txt
startup-report.json

# AI 助手本地工作记忆（工具状态，非项目源码；与 .vscode/ 同类）
.workbuddy-ai/
