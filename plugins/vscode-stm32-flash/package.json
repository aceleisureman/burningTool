{
  "name": "mcu-assistant",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "0.1.45",
  "publisher": "leisureman",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:stm32Flash.sidebar",
    "onCommand:stm32Flash.selectProject",
    "onCommand:stm32Flash.openRecent",
    "onCommand:stm32Flash.build",
    "onCommand:stm32Flash.flash",
    "onCommand:stm32Flash.buildAndFlash",
    "onCommand:stm32Flash.generateMakefile",
    "onCommand:stm32Flash.checkProbe",
    "onCommand:stm32Flash.readChipInfo",
    "onCommand:stm32Flash.cancel",
    "onCommand:stm32Flash.openOutput",
    "onCommand:stm32Flash.openSettings"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stm32Flash.selectProject",
        "title": "%cmd.selectProject%",
        "category": "STM32 Flash",
        "icon": "$(folder-opened)"
      },
      {
        "command": "stm32Flash.openRecent",
        "title": "%cmd.openRecent%",
        "category": "STM32 Flash",
        "icon": "$(history)"
      },
      {
        "command": "stm32Flash.build",
        "title": "%cmd.build%",
        "category": "STM32 Flash",
        "icon": "$(play)"
      },
      {
        "command": "stm32Flash.flash",
        "title": "%cmd.flash%",
        "category": "STM32 Flash",
        "icon": "$(arrow-up)"
      },
      {
        "command": "stm32Flash.buildAndFlash",
        "title": "%cmd.buildAndFlash%",
        "category": "STM32 Flash",
        "icon": "$(run-all)"
      },
      {
        "command": "stm32Flash.generateMakefile",
        "title": "%cmd.generateMakefile%",
        "category": "STM32 Flash"
      },
      {
        "command": "stm32Flash.checkProbe",
        "title": "%cmd.checkProbe%",
        "category": "STM32 Flash"
      },
      {
        "command": "stm32Flash.readChipInfo",
        "title": "%cmd.readChipInfo%",
        "category": "STM32 Flash"
      },
      {
        "command": "stm32Flash.cancel",
        "title": "%cmd.cancel%",
        "category": "STM32 Flash"
      },
      {
        "command": "stm32Flash.openOutput",
        "title": "%cmd.openOutput%",
        "category": "STM32 Flash"
      },
      {
        "command": "stm32Flash.openSettings",
        "title": "%cmd.openSettings%",
        "category": "STM32 Flash"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stm32Flash",
          "title": "MCU-Assistant",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "stm32Flash": [
        {
          "type": "webview",
          "id": "stm32Flash.sidebar",
          "name": "固件烧录"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "stm32Flash.buildAndFlash",
          "when": "view == stm32Flash.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "stm32Flash.openOutput",
          "when": "view == stm32Flash.sidebar",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "stm32Flash.projectDir": {
          "type": "string",
          "default": "",
          "description": "%cfg.projectDir.desc%"
        },
        "stm32Flash.targetChip": {
          "type": "string",
          "default": "stm32f103c8",
          "description": "%cfg.targetChip.desc%"
        },
        "stm32Flash.flashMethod": {
          "type": "string",
          "enum": [
            "pyocd",
            "openocd",
            "keil"
          ],
          "default": "pyocd",
          "description": "%cfg.flashMethod.desc%"
        },
        "stm32Flash.buildSystem": {
          "type": "string",
          "enum": [
            "auto",
            "make",
            "keil"
          ],
          "default": "auto",
          "description": "%cfg.buildSystem.desc%"
        },
        "stm32Flash.autoDetectChip": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoDetectChip.desc%"
        },
        "stm32Flash.connectUnderReset": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.connectUnderReset.desc%"
        },
        "stm32Flash.elfName": {
          "type": "string",
          "default": "",
          "description": "%cfg.elfName.desc%"
        },
        "stm32Flash.pyocdPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.pyocdPath.desc%"
        },
        "stm32Flash.openocdPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.openocdPath.desc%"
        },
        "stm32Flash.openocdInterface": {
          "type": "string",
          "default": "interface/cmsis-dap.cfg",
          "description": "%cfg.openocdInterface.desc%"
        },
        "stm32Flash.armGccPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.armGccPath.desc%"
        },
        "stm32Flash.makePath": {
          "type": "string",
          "default": "",
          "description": "%cfg.makePath.desc%"
        },
        "stm32Flash.keilUV4Path": {
          "type": "string",
          "default": "C:\\\\Keil_v5\\\\UV4\\\\UV4.exe",
          "description": "%cfg.keilUV4Path.desc%"
        },
        "stm32Flash.keilRebuild": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.keilRebuild.desc%"
        },
        "stm32Flash.cubeMxPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.cubeMxPath.desc%"
        },
        "stm32Flash.toolchainRootPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.toolchainRootPath.desc%"
        },
        "stm32Flash.ghProxy": {
          "type": "string",
          "default": "",
          "description": "%cfg.ghProxy.desc%"
        },
        "stm32Flash.toolchainMode": {
          "type": "string",
          "enum": [
            "custom",
            "default"
          ],
          "default": "default",
          "description": "%cfg.toolchainMode.desc%"
        },
        "stm32Flash.projectMode": {
          "type": "string",
          "enum": [
            "stm32cube",
            "keil5",
            "esp32"
          ],
          "default": "stm32cube",
          "description": "%cfg.projectMode.desc%"
        },
        "stm32Flash.esp32SubMode": {
          "type": "string",
          "enum": [
            "platformio",
            "arduino",
            "idf",
            "micropython"
          ],
          "default": "platformio",
          "description": "%cfg.esp32SubMode.desc%"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src/",
    "package": "npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {},
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/aceleisureman/burningTool"
  },
  "author": {
    "name": "锐新网络科技有限公司",
    "email": "banxiabk@gmail.com"
  },
  "qna": "marketplace",
  "bugs": {
    "url": "https://github.com/aceleisureman/burningTool/issues",
    "email": "banxiabk@gmail.com"
  },
  "homepage": "https://github.com/aceleisureman/burningTool"
}
